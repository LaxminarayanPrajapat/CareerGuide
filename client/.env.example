# ---------------------------------------------------------------------------
# AI Career Path & Skill Recommendation System - Frontend environment template
# Copy to `.env` (or `.env.local`) for local overrides.
# NEVER put an AI provider key here - API keys live only on the server.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Leave empty to use the Vite dev proxy (recommended),
# which keeps the browser on one origin so session cookies work unchanged.
VITE_API_BASE_URL=

# Optional: override the dev proxy target if the API runs elsewhere.
VITE_API_PROXY_TARGET=http://localhost:5000
