# ---------------------------------------------------------------------------
# AI Career Path & Skill Recommendation System - Backend environment template
# Copy this file to `.env` and fill in the values for your machine.
# NEVER commit a real .env file or real credentials to version control.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/career_guide

# Frontend origin allowed by CORS. Comma-separated for multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Session / token security
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=2h
COOKIE_NAME=cgs_session
CSRF_COOKIE_NAME=cgs_csrf
COOKIE_SECURE=false
SESSION_TTL_MINUTES=120

# Bootstrap administrator created on first start when no admin exists.
# Only used when the users collection is empty. Change before any shared deploy.
BOOTSTRAP_ADMIN_EMAIL=admin@careerguide.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@12345
BOOTSTRAP_ADMIN_NAME=System Administrator

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# AI provider configuration (all optional - the app stays usable without them)
# AI_PROVIDER accepts: none | gemini | openai
# ---------------------------------------------------------------------------
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2600

# ---------------------------------------------------------------------------
# Email (optional - enables the forgot/reset password workflow)
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="CareerGuide <no-reply@careerguide.local>"

# Number of automated attempts past their deadline that get auto-finalised
# by the maintenance sweep on start-up and every 60 seconds.
ATTEMPT_SWEEP_INTERVAL_MS=60000
